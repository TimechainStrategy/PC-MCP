# Planning Center MCP server credentials
# Create a Personal Access Token at:
# https://api.planningcenteronline.com/personal_access_tokens
#
# Prefer PAT for local MCP use (Basic auth):
PCO_APP_ID=your_personal_access_token_client_id
PCO_SECRET=your_personal_access_token_secret

# Alternatively, use an OAuth bearer access token (takes precedence if set):
# PCO_ACCESS_TOKEN=your_oauth_access_token

# Optional overrides
# PCO_BASE_URL=https://api.planningcenteronline.com
# PCO_API_VERSION=2026-06-04
# PCO_USER_AGENT=PC-MCP (you@example.com)
# PCO_TIMEOUT_MS=30000
# PCO_MAX_RETRIES=3
