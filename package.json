{
  "name": "pc-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for the Planning Center Online REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pc-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "planning-center",
    "pco",
    "church-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimechainStrategy/PC-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
